rules_version = '2';
// Regras do projeto Firebase "abysssub-made-in-abyss" (AbyssSub + AbyssHub juntos).
// Publique este arquivo inteiro: ele mantém a regra do AbyssSub e adiciona as do AbyssHub.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- AbyssSub ----------
    // Cada pessoa só lê e grava o próprio documento: users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- AbyssHub (Leaderboard) ----------
    // Quem está logado vê o ranking; cada pessoa só grava/apaga os próprios dados.
    match /abysshub_pessoas/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Um documento por pessoa + jogo: "{uid}__{chave do jogo}" (a chave é o nome do jogo,
    // para o mesmo jogo de lojas diferentes contar como um só)
    match /abysshub_pares/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && id == request.auth.uid + '__' + request.resource.data.chave;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Nome e foto escolhidos para o Leaderboard
    match /abysshub_perfis/{uid} {
      allow read: if request.auth != null;
      // a moldura só pode ser uma que a pessoa ganhou (ou nenhuma)
      allow write: if request.auth != null && request.auth.uid == uid
                   && (request.resource == null
                       || !('moldura' in request.resource.data)
                       || request.resource.data.moldura == ''
                       || (exists(/databases/$(database)/documents/abysshub_molduras/$(uid))
                           && request.resource.data.moldura
                              in get(/databases/$(database)/documents/abysshub_molduras/$(uid)).data.tem));
    }

    // Molduras que cada pessoa ganhou. Só o servidor (eventos) escreve.
    match /abysshub_molduras/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Foto escolhida da galeria (JPEG pequeno em texto)
    match /abysshub_fotos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (request.resource == null
                       || (request.resource.data.jpg is string && request.resource.data.jpg.size() < 300000));
    }

    // Histórico por dia de cada pessoa (Placar e Eventos). Todo mundo logado lê; cada um escreve o seu.
    match /abysshub_historico/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Quem é criador do app (crie o documento com o seu uid pelo console do Firebase).
    // Ninguém escreve aqui pelo app.
    match /abysshub_admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Eventos: todo mundo logado lê; só quem está em abysshub_admins cria, edita e apaga.
    match /abysshub_eventos/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/abysshub_admins/$(request.auth.uid));
    }

    // Ícones dos jogos (para quem não tem o jogo instalado ver). Só cria, não troca.
    match /abysshub_icones/{pacote} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.png is string
                    && request.resource.data.png.size() < 60000;
    }
  }
}
