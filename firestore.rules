rules_version = '2';
// Regras do projeto Firebase "abysssub-made-in-abyss" (AbyssSub + AbyssHub juntos).
// Publique este arquivo inteiro: ele mantém a regra do AbyssSub e adiciona as do AbyssHub.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- AbyssSub ----------
    // Cada pessoa só lê e grava o próprio documento: users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- AbyssHub (Leaderboard) ----------
    // Quem está logado vê o ranking; cada pessoa só grava/apaga os próprios dados.
    match /abysshub_pessoas/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Um documento por pessoa + jogo: "{uid}__{pacote do jogo}"
    match /abysshub_pares/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && id == request.auth.uid + '__' + request.resource.data.pacote;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Ícones dos jogos (para quem não tem o jogo instalado ver). Só cria, não troca.
    match /abysshub_icones/{pacote} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.png is string
                    && request.resource.data.png.size() < 60000;
    }
  }
}
